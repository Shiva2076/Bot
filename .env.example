# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trader:trader123@localhost:5432/tradingbot

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── Paper Trading ─────────────────────────────────────────────────────────────
STARTING_CAPITAL=1000000

# ── API auth (required). Use the same value in frontend as VITE_APP_API_KEY ──
APP_API_KEY=replace_with_a_long_random_secret

# ── Risk gate ─────────────────────────────────────────────────────────────────
RISK_MAX_DATA_AGE_SECONDS=30
RISK_PER_TRADE_PCT=1.0
RISK_DAILY_LOSS_LIMIT_PCT=3.0
RISK_MAX_OPEN_POSITIONS=5
RISK_ENFORCE_PREMARKET_GATE=true

# ── Paper costs (single calculator) ───────────────────────────────────────────
COST_BROKERAGE_PCT=0.03
COST_BROKERAGE_FLAT=20
COST_EXCHANGE_TXN_PCT=0.00345
COST_SEBI_PCT=0.0001
COST_STAMP_DUTY_BUY_PCT=0.015
COST_STT_SELL_PCT=0.025
COST_GST_PCT=18
COST_SLIPPAGE_BPS=5

# ── ORB strategy ──────────────────────────────────────────────────────────────
ORB_RANGE_MINUTES=15
ORB_CANDLE_INTERVAL=5m
ORB_REWARD_R=2.0
ORB_INVALID_AFTER_HOUR=11
ORB_INVALID_AFTER_MINUTE=0
ORB_REQUIRE_VWAP=true
ORB_REQUIRE_VOLUME=true
ORB_VOLUME_MA_PERIOD=20
ORB_VOLUME_MA_MULT=1.2

# ── Angel One SmartAPI ────────────────────────────────────────────────────────
# API key from smartapi.angelbroking.com, TOTP secret from its "Enable TOTP" page
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_QUOTE_CACHE_SECONDS=3
ANGEL_REQUESTS_PER_SECOND=4
ANGEL_MAX_CONCURRENT_REQUESTS=2

# ── Pre-market analyzer (strategy settings) ───────────────────────────────────
PREMARKET_SCHEDULER_HOUR=8
PREMARKET_SCHEDULER_MINUTE=45
PREMARKET_VIX_LOW=12
PREMARKET_VIX_HIGH=18
PREMARKET_LARGE_GAP_PCT=0.8
# Comma-separated NSE holiday dates (YYYY-MM-DD). Update each year.
PREMARKET_NSE_HOLIDAYS=2026-01-26,2026-03-03,2026-03-26,2026-03-31,2026-04-03,2026-04-14,2026-05-01,2026-08-15,2026-10-02,2026-11-09,2026-12-25

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ── Telegram (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
